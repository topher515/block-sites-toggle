{
  "name": "Block Sites (Toggle)",
  "version": "2.0.0",
  "description": "Blocks distracting sites and gives you something better to do instead.",
  "defaultMode": "focus",
  "sections": [
    {
      "id": "life",
      "title": "Life Improve 🫀",
      "enabledByDefault": true,
      "sites": [
        "*://*.reddit.com/*"
      ]
    },
    {
      "id": "work",
      "title": "Work Focus 🚧",
      "enabledByDefault": true,
      "sites": [
        "*://news.ycombinator.com/*",
        "*://*.youtube.com/*",
        "*://*.instagram.com/*"
      ]
    }
  ]
}
