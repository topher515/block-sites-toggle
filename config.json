{
  "name": "Block Sites (Toggle)",
  "version": "1.1.0",
  "description": "Tiny configurable MV3 blocker with a toggle.",
  "sections": [
    {
      "id": "life",
      "title": "Life Improve 🫀",
      "enabledByDefault": true,
      "sites": [
        "*://*.reddit.com/*"
      ]
    },
    {
      "id": "work",
      "title": "Work Focus 🚧",
      "enabledByDefault": true,
      "sites": [
        "*://news.ycombinator.com/*",
        "*://*.youtube.com/*"
      ]
    }
  ]
}

